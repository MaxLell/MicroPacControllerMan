# Build output
build/
build-host/
build-test/
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.list

# CubeMX cache / generation metadata
.mxproject

# Python harness cache
__pycache__/
*.pyc

# The trainer's virtual environment — recreated from Training/requirements.txt
.venv/

# What a training run leaves behind. `winner.json` is kept, because it is what the firmware's
# weights were generated from; a checkpoint is a pickled population, only useful to resume the run
# that wrote it, and a log is a log.
Training/checkpoint-neat-*
Training/train.log

# What `campaign.py` leaves behind: one log and one winner per run, plus the summary written for a
# human to read afterwards. The winner that gets adopted is exported over `winner.json`, so the
# directory is a working area rather than a record.
Training/campaign/
